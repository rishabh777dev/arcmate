# ActionMate Unified Environment Configuration

# Models: Strictly gemini-3.1-flash-lite or gemini-3.5-flash-lite for reasoning
GEMINI_API_KEY=
GEMINI_REASONING_MODEL=gemini-3.1-flash-lite
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Sarvam AI (Indian Voice Engine)
SARVAM_API_KEY=
VOICE_PROVIDER_PREFERENCE=gemini-first # or 'sarvam-first' to conserve credits
ENABLE_SOUNDBOX_AUDIO=true

# Supabase (PostgreSQL & Realtime)
SUPABASE_URL=https://fgupmoffipeeepfegdhl.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
USE_LOCAL_SQLITE_FALLBACK=true

# n8n Automation Engine
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/webhook/merchant-action
USE_N8N_DEMO_RUNNER=true

# Cognee Knowledge Graph
COGNEE_API_URL=http://localhost:8000
USE_LOCAL_KNOWLEDGE_FALLBACK=true

# Gateway & Ports
PORT=4000
WEB_PORT=5173
