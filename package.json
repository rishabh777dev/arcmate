{
  "name": "actionmate-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Paytm Merchant ActionMate — Autonomous AI Teammate for Indian Merchants",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node services/api-gateway/src/server.js",
    "dev:all": "concurrently \"npm run dev --workspace=apps/web\" \"npm run dev --workspace=services/api-gateway\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": "20.x || 22.x"
  }
}
